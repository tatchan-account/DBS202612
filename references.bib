	pages = {461--474},
	file = {Full Text PDF:/Users/tatsunorihashimoto/Zotero/storage/QMGTIFSM/Fu et al. - 2019 - Fast approximate nearest neighbor search with the navigating spreading-out graph.pdf:application/pdf},
}

